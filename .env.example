# Optional. Without this, signups still persist to data/waitlist.jsonl --
# the notification email is simply skipped.
RESEND_API_KEY=

# Verified sending identity on your Resend account.
WAITLIST_FROM="Delta <onboarding@resend.dev>"

# Comma-separated if you want more than one recipient.
WAITLIST_TO=reach.delta.in@gmail.com

# Optional. A Google Apps Script Web App URL that appends each signup as a
# row in a Google Sheet. See README for the five-minute setup -- no service
# account or Cloud Console needed. Without this, the sheet step is skipped.
GOOGLE_SHEETS_WEBHOOK_URL=
